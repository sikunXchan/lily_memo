+            <span className="pg-btn-text">コレクション</span>
+            <span className="pg-btn-sub">もちもの一覧</span>
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/QuestEncounterScreen.tsx b/src/components/QuestEncounterScreen.tsx
