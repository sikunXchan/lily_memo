@@ -0,0 +1,137 @@
+import { useState } from 'react';
+import { SPECIES, calcStats } from '@/game/species';
+import type { OwnedPokemon } from '@/game/types';
+
+interface TeamSelectScreenProps {
+  allPokemon: OwnedPokemon[];
+  currentTeam: number[];
+  onConfirm: (team: number[]) => void;
+  onBack: () => void;
+}
+
+export default function TeamSelectScreen({
+  allPokemon,
+  currentTeam,
+  onConfirm,
+  onBack,
+}: TeamSelectScreenProps) {
+  const [selected, setSelected] = useState<number[]>(currentTeam.slice(0, 3));
+
+  const toggle = (id: number) => {
+    setSelected(prev => {
+      if (prev.includes(id)) {
+        return prev.filter(x => x !== id);
+      }
+      if (prev.length >= 3) return prev;
+      return [...prev, id];
+    });
+  };
+
+  const moveUp = (index: number) => {
+    if (index === 0) return;
+    setSelected(prev => {
+      const next = [...prev];
+      [next[index - 1], next[index]] = [next[index], next[index - 1]];
+      return next;
+    });
+  };
+
+  const moveDown = (index: number) => {
+    if (index >= selected.length - 1) return;
+    setSelected(prev => {
+      const next = [...prev];
+      [next[index], next[index + 1]] = [next[index + 1], next[index]];
+      return next;
+    });
+  };
+
+  const removeFromSlot = (index: number) => {
+    setSelected(prev => prev.filter((_, i) => i !== index));
+  };
+
+  const canConfirm = selected.length === 3;
+
+  return (
+    <div className="pg-team-select-screen">
+      <div className="pg-ts-header">
+        <button className="pg-back-btn" onClick={onBack}>← もどる</button>
+        <div className="pg-ts-title">チームを選ぶ</div>
+        <div className="pg-ts-count">{selected.length}/3</div>
+      </div>
+
+      {/* Selected slots */}
+      <div className="pg-selected-slots">
+        {[0, 1, 2].map(i => {
+          const id = selected[i];
+          const mon = id ? allPokemon.find(p => p.id === id) : undefined;
+          return (
+            <div key={i} className={`pg-slot${mon ? ' pg-filled' : ''}`}>
+              {mon ? (
+                <>
+                  <img
+                    src={SPECIES[mon.speciesId].frontSprite}
+                    alt={mon.nickname ?? SPECIES[mon.speciesId].name}
+                    className="pg-slot-sprite"
+                  />
+                  <div className="pg-slot-name">{mon.nickname ?? SPECIES[mon.speciesId].name}</div>
+                  <div className="pg-slot-controls">
+                    <button className="pg-slot-ctrl" onClick={() => moveUp(i)} disabled={i === 0}>↑</button>
+                    <button className="pg-slot-ctrl" onClick={() => moveDown(i)} disabled={i >= selected.length - 1}>↓</button>
+                    <button className="pg-slot-ctrl pg-remove" onClick={() => removeFromSlot(i)}>×</button>
+                  </div>
+                </>
+              ) : (
+                <div className="pg-slot-empty-icon">＋</div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {/* Collection list */}
+      <div className="pg-collection-list">
+        <div className="pg-list-label">ポケモンを選ぶ</div>
+        {allPokemon.length === 0 && (
+          <div className="pg-empty-msg">ポケモンがいません</div>
+        )}
+        {allPokemon.map(mon => {
+          if (!mon.id) return null;
+          const sp = SPECIES[mon.speciesId];
+          const stats = calcStats(mon.speciesId, mon.ivs);
+          const idx = selected.indexOf(mon.id);
+          const isSelected = idx !== -1;
+          const isFull = selected.length >= 3 && !isSelected;
+          return (
+            <button
+              key={mon.id}
+              className={`pg-mon-item${isSelected ? ' pg-selected' : ''}${isFull ? ' pg-disabled' : ''}`}
+              onClick={() => toggle(mon.id!)}
+              disabled={isFull}
+            >
+              <div className="pg-mon-rank">{isSelected ? `#${idx + 1}` : ''}</div>
+              <img src={sp.frontSprite} alt={sp.name} className="pg-mon-sprite" />
+              <div className="pg-mon-details">
+                <div className="pg-mon-name">{mon.nickname ?? sp.name}</div>
+                <div className="pg-mon-stats">
+                  HP:{stats.maxHP} ATK:{stats.atk} DEF:{stats.def}
+                </div>
+              </div>
+              {isSelected && <div className="pg-check-icon">✓</div>}
+            </button>
+          );
+        })}
+      </div>
+
+      {/* Confirm button */}
+      <div className="pg-confirm-wrap">
+        <button
+          className={`pg-confirm-btn${canConfirm ? ' pg-active' : ' pg-inactive'}`}
+          onClick={() => canConfirm && onConfirm(selected)}
+          disabled={!canConfirm}
+        >
+          {canConfirm ? 'バトル開始！' : `あと${3 - selected.length}体選ぼう`}
+        </button>
+      </div>
+    </div>
+  );
+}
