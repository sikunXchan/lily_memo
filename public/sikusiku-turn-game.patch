@@ -0,0 +1,129 @@
+import { useEffect, useState } from 'react';
+import { SPECIES } from '@/game/species';
+import type { SpeciesId } from '@/game/types';
+
+interface QuestEncounterScreenProps {
+  teamSize: number;
+  wildSpeciesId?: SpeciesId;
+  catchMode?: boolean;
+  catchResult?: 'caught' | 'fled' | null;
+  onFight: () => void;
+  onFlee: () => void;
+  onCatchAttempt?: () => void;
+  onSelectTeam: () => void;
+}
+
+const ALL_SPECIES: SpeciesId[] = ['chakun', 'shikun'];
+
+export default function QuestEncounterScreen({
+  teamSize,
+  wildSpeciesId,
+  catchMode,
+  catchResult,
+  onFight,
+  onFlee,
+  onCatchAttempt,
+  onSelectTeam,
+}: QuestEncounterScreenProps) {
+  // Pick a random species to preview if not given
+  const [previewSpecies] = useState<SpeciesId>(
+    () => wildSpeciesId ?? ALL_SPECIES[Math.floor(Math.random() * ALL_SPECIES.length)]
+  );
+
+  const [animated, setAnimated] = useState(false);
+
+  useEffect(() => {
+    const timer = setTimeout(() => setAnimated(true), 50);
+    return () => clearTimeout(timer);
+  }, []);
+
+  const sp = SPECIES[previewSpecies];
+
+  if (catchMode) {
+    return (
+      <div className="pg-quest-screen">
+        <div className={`pg-wild-mon${animated ? ' pg-show' : ''}`}>
+          <img src={sp.frontSprite} alt={sp.name} className="pg-wild-sprite pg-catch-anim" />
+        </div>
+
+        {catchResult === null && (
+          <>
+            <div className="pg-encounter-title">捕まえようとする！</div>
+            <div className="pg-encounter-sub">{sp.name}をゲットできるかも！</div>
+            <div className="pg-btn-row">
+              <button className="pg-quest-action-btn pg-catch-btn" onClick={onCatchAttempt}>
+                ボールを投げる！
+              </button>
+              <button className="pg-quest-action-btn pg-flee-btn" onClick={onFlee}>
+                あきらめる
+              </button>
+            </div>
+          </>
+        )}
+
+        {catchResult === 'caught' && (
+          <>
+            <div className="pg-result-emoji">🎉</div>
+            <div className="pg-encounter-title pg-caught-title">捕まえた！</div>
+            <div className="pg-encounter-sub">{sp.name}があなたのポケモンになった！</div>
+            <button className="pg-quest-action-btn pg-done-btn" onClick={onFlee}>
+              つづける
+            </button>
+          </>
+        )}
+
+        {catchResult === 'fled' && (
+          <>
+            <div className="pg-result-emoji">💨</div>
+            <div className="pg-encounter-title">逃げられた…</div>
+            <div className="pg-encounter-sub">また次回チャレンジしよう！</div>
+            <button className="pg-quest-action-btn pg-flee-btn" onClick={onFlee}>
+              もどる
+            </button>
+          </>
+        )}
+      </div>
+    );
+  }
+
+  return (
+    <div className="pg-quest-screen">
+      {teamSize === 0 && (
+        <div className="pg-warning-banner">
+          ポケモンがいません！チームを選んでください
+        </div>
+      )}
+
+      <div className={`pg-wild-mon${animated ? ' pg-show' : ''}`}>
+        <div className="pg-silhouette-wrap">
+          <img
+            src={sp.frontSprite}
+            alt="野生のポケモン"
+            className="pg-wild-sprite pg-encounter-bounce"
+            style={{ filter: 'brightness(0) drop-shadow(0 0 20px rgba(147,112,219,0.8))' }}
+          />
+        </div>
+      </div>
+
+      <div className="pg-encounter-title">野生の{sp.name}が現れた！</div>
+      <div className="pg-encounter-sub">どうする？</div>
+
+      <div className="pg-btn-row">
+        <button
+          className="pg-quest-action-btn pg-fight-btn"
+          onClick={onFight}
+          disabled={teamSize === 0}
+          style={{ opacity: teamSize === 0 ? 0.4 : 1, cursor: teamSize === 0 ? 'not-allowed' : 'pointer' }}
+        >
+          ⚔️ たたかう！
+        </button>
+        <button className="pg-quest-action-btn pg-team-btn" onClick={onSelectTeam}>
+          👥 チームを変える
+        </button>
+        <button className="pg-quest-action-btn pg-flee-btn" onClick={onFlee}>
+          💨 にげる
+        </button>
+      </div>
+    </div>
+  );
+}
